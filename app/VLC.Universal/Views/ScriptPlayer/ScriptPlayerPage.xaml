<Page
    x:Class="VLC.UI.Views.ScriptPlayer.ScriptPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Background="Transparent">
        <!-- User Prompt / QTE Decision Banner Overlay -->
        <Grid
            x:Name="PromptContainer"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,64"
            Visibility="Collapsed">
            <Border
                Background="#E6151515"
                BorderBrush="#FF8000"
                BorderThickness="3"
                CornerRadius="12"
                Padding="32,16">
                <TextBlock
                    x:Name="PromptText"
                    Text="Press [A] to Jump | Press [B] to Duck"
                    Foreground="#FFFFFF"
                    FontSize="28"
                    FontWeight="SemiBold"
                    TextAlignment="Center" />
            </Border>
        </Grid>

        <!-- Toggleable On-Screen Debug HUD (View + Menu / H Key) -->
        <Grid
            x:Name="DebugHud"
            Visibility="Visible"
            Background="#D9050505"
            Margin="32"
            Padding="24"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- HUD Header -->
            <Border Grid.Row="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="VLC SCRIPT PLAYER" Foreground="#FF8000" FontWeight="Bold" FontSize="20" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <TextBlock x:Name="HudScriptTitle" Text="[No Script Loaded]" Foreground="#A0A0A0" FontSize="16" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="Toggle HUD: [View]+[Menu] | [H]" Foreground="#707070" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="Exit" Click="OnExitClicked" Foreground="#FFFFFF" Background="#333333" Padding="12,4" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- HUD Main Body: Telemetry & Log Panels -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: FSM & Playback State -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Playback Info Card -->
                        <Border Background="#1C1C1C" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="PLAYBACK ENGINE (libVLC)" Foreground="#FF8000" FontWeight="Bold" FontSize="13" Margin="0,0,0,6" />
                                <TextBlock x:Name="HudMediaId" Text="Media: None" Foreground="#FFFFFF" FontSize="14" Margin="0,0,0,6" />
                                <TextBlock x:Name="HudTimeCode" Text="Time: 00:00.000 / 00:00.000" Foreground="#FFFFFF" FontSize="14" Margin="0,0,0,6" />
                                <ProgressBar x:Name="HudPlaybackProgress" Height="6" Minimum="0" Maximum="100" Value="0" Foreground="#FF8000" Background="#333333" />
                            </StackPanel>
                        </Border>

                        <!-- FSM Status Card -->
                        <Border Background="#1C1C1C" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="FSM STATE MACHINE" Foreground="#FF8000" FontWeight="Bold" FontSize="13" Margin="0,0,0,6" />
                                <TextBlock x:Name="HudCurrentState" Text="State: Idle" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock x:Name="HudLastEvent" Text="Last Event: (None)" Foreground="#CCCCCC" FontSize="13" Margin="0,0,0,6" />
                                <TextBlock x:Name="HudActiveTimers" Text="Active Timers: 0" Foreground="#CCCCCC" FontSize="13" />
                            </StackPanel>
                        </Border>

                        <!-- Variable Watch Card -->
                        <Border Background="#1C1C1C" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="VARIABLE STORE" Foreground="#FF8000" FontWeight="Bold" FontSize="13" Margin="0,0,0,6" />
                                <TextBlock x:Name="HudVariables" Text="(No variables)" Foreground="#E0E0E0" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right Column: Event & Action Log Stream -->
                <Border Grid.Column="2" Background="#141414" CornerRadius="8" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="TELEMETRY LOG STREAM" Foreground="#FF8000" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                        <ListView
                            x:Name="HudLogList"
                            Grid.Row="1"
                            SelectionMode="None"
                            Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#CCCCCC" FontSize="12" FontFamily="Consolas, Courier New" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- HUD Footer -->
            <Border Grid.Row="2" BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="[A/B/X/Y] Choices" Foreground="#888888" FontSize="12" Margin="0,0,24,0" />
                    <TextBlock Text="[DPad] Navigate" Foreground="#888888" FontSize="12" Margin="0,0,24,0" />
                    <TextBlock Text="[LeftStick] Reload Script" Foreground="#888888" FontSize="12" Margin="0,0,24,0" />
                    <TextBlock Text="[RightStick] Scan USB" Foreground="#888888" FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
