<Page x:Class="VLC.UI.Views.VideoPages.VideoNowPlayingControls.ScriptSettings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:VLC.UI.Views.VideoPages.VideoNowPlayingControls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="360"
      d:DesignWidth="400"
      VerticalAlignment="Bottom">

    <Border x:Name="RootGrid"
            Background="{ThemeResource ApplicationOverlayTranslucentThemeBrush}"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Width="320"
            Padding="{StaticResource FrameMarginBothSides}"
            DataContext="{Binding Source={StaticResource Locator}, Path=VideoPlayerVm}">
        <StackPanel>
            <TextBlock Text="Script Settings"
                       Style="{StaticResource SubheaderTextBlockStyle}"
                       Foreground="{ThemeResource BasicForeground}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <TextBlock Text="{Binding LoadedScriptDisplayName}"
                       Foreground="#FF8000"
                       FontWeight="SemiBold"
                       FontSize="15"
                       TextWrapping="Wrap"
                       Margin="0,12,0,2" />

            <TextBlock Text="{Binding ScriptStatusText}"
                       Foreground="{ThemeResource BasicForeground}"
                       FontSize="13"
                       Margin="0,0,0,12" />

            <ToggleSwitch Header="Activate Script"
                          IsOn="{Binding IsScriptActive, Mode=TwoWay}"
                          IsEnabled="{Binding HasLoadedScript}"
                          Margin="0,0,0,6" />

            <ToggleSwitch Header="Show Debug HUD"
                          IsOn="{Binding IsScriptDebugHudVisible, Mode=TwoWay}"
                          IsEnabled="{Binding IsScriptActive}"
                          Margin="0,0,0,12" />

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Open..."
                        HorizontalAlignment="Stretch"
                        Command="{Binding OpenScriptCommand}" />
                <Button Grid.Column="2"
                        Content="Unload"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{Binding HasLoadedScript}"
                        Command="{Binding UnloadScriptCommand}" />
            </Grid>
        </StackPanel>
    </Border>
</Page>
